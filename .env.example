# Flask 설정
FLASK_APP=app.py
FLASK_ENV=production

# 서버 설정
HOST=0.0.0.0
PORT=5000

# 업로드 설정
MAX_CONTENT_LENGTH=16777216  # 16MB (바이트 단위)
UPLOAD_FOLDER=uploads
RESULT_FOLDER=results

# 데이터셋 경로 (선택사항)
# Windows: D:/pet-aegen-teto-dataset
# Linux: /data/pet-aegen-teto-dataset
DATASET_FOLDER=D:/pet-aegen-teto-dataset

# 모델 파일 경로 (선택사항)
MODEL_PATH=best_model_aegen_teto_ensemble.pth

# 로깅 설정
LOG_LEVEL=INFO

# CORS 설정 (개발 환경)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
